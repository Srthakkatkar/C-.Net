@model DrivingSchoolApp.Models.Student

<h2>Add Student</h2>

<div class="form-container">
    <form method="post">
        <label>Name</label>
        <input type="text" name="Name" required />

        <label>Phone</label>
        <input type="text" name="Phone" />

        <label>Course</label>
        <select name="Course">
            <option>2-Wheeler</option>
            <option>4-Wheeler</option>
        </select>

        <label>Fees</label>
        <input type="number" name="Fees" />

        <label>Status</label>
        <select name="Status">
            <option>Pending</option>
            <option>Completed</option>
        </select>

        <button type="submit">Save Student</button>
    </form>

    <a href="/Student" class="back">← Back to List</a>
</div>

<style>
    body {
        font-family: Arial;
        background-color: #f5f5f5;
    }

    .form-container {
        width: 350px;
        margin: 40px auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 5px #ccc;
    }

    label {
        display: block;
        margin-top: 10px;
        font-weight: bold;
    }

    input, select {
        width: 100%;
        padding: 6px;
        margin-top: 5px;
    }

    button {
        margin-top: 15px;
        width: 100%;
        padding: 8px;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
    }

    button:hover {
        background: #0056b3;
    }

    .back {
        display: block;
        margin-top: 10px;
        text-align: center;
    }
</style>